{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cấu hình Đối chiếu bản ký",
  "type": "object",
  "properties": {
    "phien_ban_cau_hinh": {
      "type": "string",
      "minLength": 1
    },
    "ma_bo_chuan_hoa": {
      "type": "string",
      "minLength": 1
    },
    "bam_bo_chuan_hoa": {
      "type": "string",
      "minLength": 1
    },
    "ma_tu_dien": {
      "type": "string",
      "minLength": 1
    },
    "bam_tu_dien": {
      "type": "string",
      "minLength": 1
    },
    "phuong_phap_detector": {
      "type": "string",
      "minLength": 1
    },
    "phien_ban_detector": {
      "type": "string",
      "minLength": 1
    },
    "thoi_han_chiem_luot_giay": {
      "type": "integer",
      "minimum": 1,
      "description": "Thời hạn chiếm lượt trong ngăn; bỏ trống thì dùng thời hạn bước nhận cặp cộng 60 giây."
    },
    "nguong_ocr_kem": {
      "enum": [
        null
      ],
      "default": null,
      "description": "Chưa đo; chưa được dùng để kết luận sạch."
    },
    "so_trang_toi_da": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 60
    },
    "ky_tu_moi_tai_lieu": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500000,
      "default": 500000
    },
    "ky_tu_hai_tai_lieu": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "default": 1000000
    },
    "diem_lech_toi_da": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 10000
    },
    "ho_so_mib": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    },
    "tep_mib": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    },
    "pixel_anh": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000000,
      "default": 20000000
    },
    "tong_byte_tep_con": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728,
      "default": 134217728
    },
    "docx_giai_nen_mib": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 100
    },
    "docx_so_muc": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 2000
    },
    "hoc_loi_ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "so_lan",
        "phien_ban",
        "nguon_do",
        "ma_phe_duyet"
      ],
      "properties": {
        "so_lan": {
          "type": "integer",
          "minimum": 1
        },
        "phien_ban": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "nguon_do": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "ma_phe_duyet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "description": "Ngưỡng đề xuất sau đo và phê duyệt; không có mặc định, thiếu thì không học hoặc duyệt."
    }
  },
  "additionalProperties": false,
  "description": "Cho phép chưa cấu hình khi khởi động; việc cần đủ bảy mã/phiên bản bắt buộc, thiếu trả CHUA_CAU_HINH."
}
