{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bài học khi AI sai — PL-10B",
  "type": "object",
  "additionalProperties": false,
  "required": ["phien_ban", "ma_module", "khau", "phien_ban_engine", "dong"],
  "properties": {
    "phien_ban": {"const": 1, "type": "integer"},
    "ma_module": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"},
    "khau": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "phien_ban_engine": {"type": "string", "minLength": 1},
    "dong": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ma_luot", "ma", "loai", "loai_dung", "nguon_loai", "nguon_mau",
          "ket_qua", "muc_sai", "ai_bo_sot", "ai_sai_loai", "da_ghi_truoc", "giai_thich"
        ],
        "properties": {
          "ma_luot": {"type": "string", "minLength": 1},
          "ma": {"type": "string", "minLength": 1, "maxLength": 120},
          "loai": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "loai_dung": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "nguon_loai": {"enum": ["module", "quy_tac", "ai", "chua_phan_loai", null]},
          "nguon_mau": {"enum": ["chon_mau", "bat_buoc", "ngoai_mau"]},
          "ket_qua": {"enum": ["dat", "sai", "khong_kiem"]},
          "muc_sai": {"enum": ["nho", "sad", "te", null]},
          "ai_bo_sot": {"type": "boolean"},
          "ai_sai_loai": {"type": "boolean"},
          "da_ghi_truoc": {"type": "boolean"},
          "giai_thich": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "anyOf": [
          {"properties": {"ai_bo_sot": {"const": true}}},
          {"properties": {"ai_sai_loai": {"const": true}}}
        ]
      }
    }
  }
}
