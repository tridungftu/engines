{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cấu hình máy của engine OCR, không chứa bí mật",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "abbyy": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "bat": {"type": "boolean", "default": false},
        "thu_muc_vao": {"type": "string", "maxLength": 4096, "default": ""},
        "thu_muc_ra": {"type": "string", "maxLength": 4096, "default": ""},
        "thoi_han_giay": {"type": "integer", "minimum": 1, "maximum": 900, "default": 900},
        "han_muc_trang_30_ngay": {"type": "integer", "minimum": 0, "maximum": 5000, "default": 5000}
      }
    },
    "tesseract": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "duong_dan": {"type": "string", "maxLength": 4096, "default": ""},
        "ngon_ngu": {"type": "string", "minLength": 1, "maxLength": 200, "default": "vie+eng"}
      }
    }
  }
}
