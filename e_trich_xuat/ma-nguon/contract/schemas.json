{
  "urn:ktt:contract:chung.v1": {
    "$comment": "Phien ban 1.0.0",
    "$defs": {
      "chuoi": {
        "minLength": 1,
        "type": "string"
      },
      "dan_chung": {
        "additionalProperties": false,
        "properties": {
          "trich_dan": {
            "$ref": "#/$defs/chuoi"
          },
          "vi_tri": {
            "$ref": "#/$defs/vi_tri"
          }
        },
        "required": [
          "vi_tri",
          "trich_dan"
        ],
        "type": "object"
      },
      "gia_tri": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "gia_tri": {
                "type": "string"
              },
              "kieu": {
                "const": "van_ban"
              }
            },
            "required": [
              "kieu",
              "gia_tri"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "don_vi": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "gia_tri": {
                "$ref": "#/$defs/thap_phan"
              },
              "kieu": {
                "const": "so"
              }
            },
            "required": [
              "kieu",
              "gia_tri",
              "don_vi"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "don_vi_tien": {
                "$ref": "#/$defs/tien/properties/don_vi_tien"
              },
              "gia_tri": {
                "$ref": "#/$defs/tien/properties/gia_tri"
              },
              "kieu": {
                "const": "tien"
              }
            },
            "required": [
              "kieu",
              "gia_tri",
              "don_vi_tien"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "gia_tri": {
                "$ref": "#/$defs/ngay"
              },
              "kieu": {
                "const": "ngay"
              }
            },
            "required": [
              "kieu",
              "gia_tri"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "gia_tri": {
                "type": "boolean"
              },
              "kieu": {
                "const": "logic"
              }
            },
            "required": [
              "kieu",
              "gia_tri"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kieu": {
                "const": "chua_ro"
              },
              "ly_do": {
                "$ref": "#/$defs/chuoi"
              }
            },
            "required": [
              "kieu",
              "ly_do"
            ],
            "type": "object"
          }
        ]
      },
      "id": {
        "format": "uuid",
        "type": "string"
      },
      "ma": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "ngay": {
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "type": "string"
      },
      "sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "thap_phan": {
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
        "type": "string"
      },
      "thoi_diem": {
        "format": "date-time",
        "pattern": "Z$",
        "type": "string"
      },
      "tien": {
        "additionalProperties": false,
        "properties": {
          "don_vi_tien": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "gia_tri": {
            "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
            "type": "string"
          }
        },
        "required": [
          "gia_tri",
          "don_vi_tien"
        ],
        "type": "object"
      },
      "vi_tri": {
        "additionalProperties": false,
        "dependentRequired": {
          "bbox": [
            "khung_toa_do"
          ]
        },
        "properties": {
          "bbox": {
            "items": {
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "dinh_vi": {
            "$ref": "#/$defs/chuoi"
          },
          "khung_toa_do": {
            "additionalProperties": false,
            "properties": {
              "cao": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "don_vi": {
                "enum": [
                  "pdf_point",
                  "pixel"
                ]
              },
              "rong": {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            },
            "required": [
              "don_vi",
              "rong",
              "cao"
            ],
            "type": "object"
          },
          "tep_id": {
            "$ref": "#/$defs/id"
          },
          "trang": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "tep_id",
          "dinh_vi"
        ],
        "type": "object"
      },
      "vo_noi_dung": {
        "properties": {
          "contract": {
            "type": "string"
          },
          "nguon_tep_ids": {
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "phien_ban": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "contract",
          "phien_ban",
          "revision",
          "nguon_tep_ids"
        ],
        "type": "object"
      }
    },
    "$id": "urn:ktt:contract:chung.v1",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "chung.v1"
  },
  "urn:ktt:contract:tham_chieu_tep.v1": {
    "$id": "urn:ktt:contract:tham_chieu_tep.v1",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "contract": {
        "const": "tham_chieu_tep.v1"
      },
      "het_han_luc": {
        "oneOf": [
          {
            "$ref": "urn:ktt:contract:chung.v1#/$defs/thoi_diem"
          },
          {
            "type": "null"
          }
        ]
      },
      "kich_thuoc": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "mime": {
        "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
        "type": "string"
      },
      "phien_ban": {
        "const": "1.0.0"
      },
      "sha256": {
        "$ref": "urn:ktt:contract:chung.v1#/$defs/sha256"
      },
      "ten_tep": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "tep_id": {
        "$ref": "urn:ktt:contract:chung.v1#/$defs/id"
      }
    },
    "required": [
      "contract",
      "phien_ban",
      "tep_id",
      "ten_tep",
      "mime",
      "kich_thuoc",
      "sha256",
      "het_han_luc"
    ],
    "title": "tham_chieu_tep.v1",
    "type": "object"
  },
  "urn:ktt:contract:tham_so.v1": {
    "$id": "urn:ktt:contract:tham_so.v1",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "$ref": "urn:ktt:contract:chung.v1#/$defs/vo_noi_dung"
      }
    ],
    "properties": {
      "contract": {
        "const": "tham_so.v1"
      },
      "danh_muc_id": {
        "minLength": 1,
        "type": "string"
      },
      "danh_muc_sha256": {
        "$ref": "urn:ktt:contract:chung.v1#/$defs/sha256"
      },
      "loai_hop_dong": {
        "minLength": 1,
        "type": "string"
      },
      "phan_hoi_nguon_tep_id": {
        "$ref": "urn:ktt:contract:chung.v1#/$defs/id"
      },
      "phien_ban": {
        "const": "1.0.0"
      },
      "tham_so": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "can_soat": {
              "type": "boolean"
            },
            "canh_bao": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "dan_chung": {
              "items": {
                "$ref": "urn:ktt:contract:chung.v1#/$defs/dan_chung"
              },
              "type": "array"
            },
            "gia_tri": {
              "$ref": "urn:ktt:contract:chung.v1#/$defs/gia_tri"
            },
            "ma": {
              "minLength": 1,
              "type": "string"
            },
            "nguyen_van": {
              "type": [
                "string",
                "null"
              ]
            },
            "ten": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "ma",
            "ten",
            "gia_tri",
            "nguyen_van",
            "dan_chung",
            "can_soat",
            "canh_bao"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "loai_hop_dong",
      "danh_muc_id",
      "danh_muc_sha256",
      "tham_so",
      "phan_hoi_nguon_tep_id"
    ],
    "title": "tham_so.v1",
    "type": "object",
    "unevaluatedProperties": false
  }
}
